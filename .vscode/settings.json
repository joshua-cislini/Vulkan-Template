{
	// clangd provides IntelliSense (from compile_commands.json, generated by make);
	// the Microsoft C/C++ extension is only used for debugging.
	"C_Cpp.intelliSenseEngine": "disabled",
	"clangd.arguments": [
		"--background-index",
		"--clang-tidy",
		"--completion-style=detailed",
		"--header-insertion=never",
		"--query-driver=**/*g++*,**/*gcc*,**/*clang*,**/cc*"
	],
	"[cpp]": {
		"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
		"editor.formatOnSave": true
	},
	"[c]": {
		"editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
		"editor.formatOnSave": true
	},
	"files.associations": {
		"*.hpp": "cpp",
		"*.cpp": "cpp",
		"*.h": "cpp",
		"*.mk": "makefile",
		"*.vert": "glsl",
		"*.frag": "glsl",
		"*.comp": "glsl",
		"*.geom": "glsl",
		"*.tesc": "glsl",
		"*.tese": "glsl",
		"*.mesh": "glsl",
		"*.task": "glsl",
		"*.rgen": "glsl",
		"*.rchit": "glsl",
		"*.rmiss": "glsl"
	},
	"files.exclude": {
		"**/.cache": true
	},
	"explorer.sortOrder": "type"
}